# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. See DATABASE_SETUP.md for full setup instructions.

# --- Database ---------------------------------------------------------
# Local Docker Postgres (docker-compose.yml maps host port 5433 -> 5432
# inside the container, to avoid clashing with any Postgres already
# running on your machine on the default 5432):
DATABASE_URL="postgresql://project_vault:project_vault_dev_password@localhost:5433/project_vault?schema=public"

# Any other valid PostgreSQL connection string also works, e.g. a hosted
# instance (Neon, Supabase, RDS, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ------------------------------------------------------------
# Session-signing secret. Generate one with:
#   openssl rand -base64 32
# Never reuse a development secret in production, and never commit a real one.
AUTH_SECRET="replace-with-a-generated-secret"

# Not set by default: `trustHost: true` (src/auth.ts) makes Auth.js derive
# the canonical URL from the incoming request's Host header, which is what
# lets the dev server and test runners work on any port without editing
# this file. Uncomment and set explicitly only for a real deployment
# behind a fixed public URL (and reconsider `trustHost` there too — it's
# a reasonable default for local dev, less so behind an untrusted proxy).
# AUTH_URL="https://your-real-domain.example.com"

# --- Object storage (Phase 5) --------------------------------------------
# See FILE_STORAGE_ARCHITECTURE.md for the full model. Local dev/test
# target MinIO (docker-compose.yml); production targets real AWS S3 — see
# src/storage/storage-config.ts, which refuses to boot in production with
# these development defaults still in place.
STORAGE_PROVIDER="s3"

# MinIO's local S3-compatible endpoint. Leave S3_ENDPOINT unset entirely
# for real AWS S3 (the SDK resolves the endpoint from S3_REGION instead).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="project-vault-files"
# Development-only MinIO credentials (match docker-compose.yml). Never
# reuse these, or any value resembling them, in production.
S3_ACCESS_KEY_ID="project_vault_dev"
S3_SECRET_ACCESS_KEY="project_vault_dev_password"
# Required "true" for MinIO (path-style buckets); real AWS S3 should
# leave this "false" (virtual-hosted-style).
S3_FORCE_PATH_STYLE="true"

# --- Upload limits (Phase 5) ----------------------------------------------
# All in bytes / plain integers. Centralized in src/storage/storage-config.ts.
UPLOAD_MAX_FILE_SIZE_BYTES="52428800"
UPLOAD_MAX_FILES_PER_WORKSPACE="50"
UPLOAD_MAX_TOTAL_WORKSPACE_BYTES="524288000"
UPLOAD_SESSION_EXPIRY_SECONDS="900"

# --- Preview / processing limits (Phase 5) --------------------------------
PREVIEW_MAX_INPUT_DIMENSION_PX="8000"
PREVIEW_MAX_OUTPUT_DIMENSION_PX="1600"
PREVIEW_PROCESSING_TIMEOUT_MS="30000"
PREVIEW_QUALITY="80"

# --- File processing worker (Phase 5) -------------------------------------
# Keep these local defaults as-is. On the deployed Render demo worker
# specifically — after measuring that POST /wake alone isn't shortening the
# wait enough — a shorter poll interval is reasonable:
#   FILE_WORKER_POLL_INTERVAL_MS="500"   (or "1000")
# Only raise FILE_WORKER_CONCURRENCY above 1 after confirming the instance
# has memory/CPU headroom for two simultaneous Sharp jobs — on a
# memory-constrained (e.g. 512MB) Render instance, keep it at 1 and instead
# set SHARP_CONCURRENCY="1" (see image-preview.ts) to cap libvips' own
# thread pool.
FILE_WORKER_POLL_INTERVAL_MS="1000"
FILE_WORKER_MAX_ATTEMPTS="3"
FILE_WORKER_CONCURRENCY="1"
# SHARP_CONCURRENCY="1"

# Leave unset for a project-duration link.
# REVIEW_LINK_EXPIRY_DAYS="30"
# How long a completed project's history is retained through its read-only
# master link before an operator-run cleanup would be expected to remove it.
# Informational only in this phase — no automated deletion job runs yet.
REVIEW_LINK_RETENTION_DAYS="180"

# --- Payments (Phase 7) ----------------------------------------------------
# See PAYMENT_ARCHITECTURE.md. "fake" (default) is a deterministic
# in-memory test double — forbidden in production (src/payments/payment-config.ts
# refuses to start with PAYMENT_PROVIDER="fake" while NODE_ENV=production).
# Set "razorpay" plus real credentials below for any real Checkout flow.
PAYMENT_PROVIDER="fake"

# Client-visible key id (safe to expose — Razorpay's key id is a public
# identifier, never a secret). Must equal RAZORPAY_KEY_ID when
# PAYMENT_PROVIDER="razorpay".
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Server-only. NEVER put the key secret or webhook secret in a
# NEXT_PUBLIC_ variable.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# "test" or "live". Production boot refuses "test" (or a key id that
# doesn't look live) while NODE_ENV=production.
RAZORPAY_MODE="test"

# Minimum seconds between two reconciliation attempts for the same
# payment (see src/data-access/payment-reconciliation.ts).
PAYMENT_RECONCILIATION_COOLDOWN="30"

# --- Secure download grants / delivery bundles (Phase 7) -------------------
# See SECURE_DOWNLOAD_ARCHITECTURE.md. DOWNLOAD_GRANT_TTL is in seconds
# (default 14 days).
DOWNLOAD_GRANT_TTL="1209600"
DOWNLOAD_GRANT_MAX_DOWNLOADS="20"
# Max creator-triggered retries for a failed delivery-bundle build.
DELIVERY_WORKER_MAX_ATTEMPTS="3"
# Storage-key prefix for private delivery ZIP bundles.
DELIVERY_BUNDLE_PREFIX="deliveries"
# Demo-tier cap on total delivery-bundle (ZIP) size, in bytes.
MAX_DELIVERY_BUNDLE_BYTES="524288000"

# --- Deployment mode (demo deployment) --------------------------------------
# Unset/"development" (default) here. See .env.demo.example and
# DEMO_DEPLOYMENT.md for the full INLAY demo-deployment configuration —
# APP_ENV="demo" unlocks a small number of narrow, explicit allowances
# (Razorpay test mode + fake payouts under NODE_ENV=production, and the
# combined-process demo supervisor) that are otherwise refused.
# APP_ENV="demo"

# --- Demo-facing resource-limit aliases -------------------------------------
# These are alternate names for the Upload/Preview/Download-grant limits
# above (src/storage/storage-config.ts checks the demo name first, then
# falls back to the original name) — only meaningful to set in a demo
# deployment; leave unset here for local development.
# MAX_FILE_SIZE_BYTES, MAX_WORKSPACE_FILES, MAX_WORKSPACE_STORAGE_BYTES,
# MAX_IMAGE_DIMENSION, PREVIEW_MAX_DIMENSION, DOWNLOAD_GRANT_TTL_SECONDS

# --- Worker/Sharp concurrency (demo deployment) -----------------------------
# Default 1 for both (byte-for-byte today's sequential worker behavior).
# FILE_WORKER_CONCURRENCY="1"
# DELIVERY_WORKER_CONCURRENCY="1"
# SHARP_CONCURRENCY unset by default — leaves Sharp's own CPU-count-based
# default untouched; set only on a resource-constrained deployment.
# SHARP_CONCURRENCY="1"

# --- Support (Phase 8) -------------------------------------------------
# Shown in the creator's Settings page "Support" section — see
# src/app/(creator)/settings/page.tsx. No ticket system; just a contact
# email and an optional WhatsApp/phone link. Both are client-visible
# (NEXT_PUBLIC_) — never put a secret in either. If
# NEXT_PUBLIC_SUPPORT_EMAIL is unset, Settings shows a neutral "Support
# contact is not configured" message. If NEXT_PUBLIC_SUPPORT_PHONE is
# unset, the WhatsApp/phone action is hidden.
# NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# NEXT_PUBLIC_SUPPORT_PHONE="+91 90000 00000"

# --- Legacy / retired (Phase 8) -----------------------------------------
# PLATFORM_FEE_BPS no longer affects anything — INLAY charges no platform
# fee (src/payments/platform-fee.ts's getPlatformFeeBps() always returns
# 0). Safe to leave set during rollout; safe to remove entirely.
# PLATFORM_FEE_BPS="0"
