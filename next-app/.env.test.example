# Copy to .env.test. Must point at a database that is NOT your development
# database — integration tests wipe and reseed it on every run.
TEST_DATABASE_URL="postgresql://project_vault:project_vault_dev_password@localhost:5433/project_vault_test?schema=public"

# --- Object storage (Phase 5) ---------------------------------------------
# Storage integration tests (src/storage/*.integration.test.ts,
# src/data-access/files.integration.test.ts) talk to the same local MinIO
# instance as dev — every object they create uses a fresh random storage
# key (see src/storage/storage-keys.ts), so nothing collides with
# development data, and each test deletes what it creates.
STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="project-vault-files"
S3_ACCESS_KEY_ID="project_vault_dev"
S3_SECRET_ACCESS_KEY="project_vault_dev_password"
S3_FORCE_PATH_STYLE="true"

UPLOAD_MAX_FILE_SIZE_BYTES="52428800"
UPLOAD_MAX_FILES_PER_WORKSPACE="50"
UPLOAD_MAX_TOTAL_WORKSPACE_BYTES="524288000"
UPLOAD_SESSION_EXPIRY_SECONDS="900"

PREVIEW_MAX_INPUT_DIMENSION_PX="8000"
PREVIEW_MAX_OUTPUT_DIMENSION_PX="1600"
PREVIEW_PROCESSING_TIMEOUT_MS="30000"
PREVIEW_QUALITY="80"

FILE_WORKER_POLL_INTERVAL_MS="1000"
FILE_WORKER_MAX_ATTEMPTS="3"

# --- Payments (Phase 7) ----------------------------------------------------
# Integration tests always use the deterministic fake gateway — never real
# Razorpay credentials. See src/payments/fake-payment-gateway.ts.
PAYMENT_PROVIDER="fake"
PAYMENT_RECONCILIATION_COOLDOWN="30"
DOWNLOAD_GRANT_TTL="1209600"
DOWNLOAD_GRANT_MAX_DOWNLOADS="20"
DELIVERY_WORKER_MAX_ATTEMPTS="3"
DELIVERY_BUNDLE_PREFIX="deliveries"
