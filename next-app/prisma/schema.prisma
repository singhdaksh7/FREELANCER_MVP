// Project Vault — Phase 3 schema.
// Scope: creator auth + read-only creator screens (dashboard, workspaces,
// clients, payments, notifications). Mutation-only fields (comments,
// versions, file storage, webhooks, etc.) are deliberately out of scope —
// see TECHNICAL_AUDIT.md and MIGRATION_STATUS.md for the full roadmap.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CREATOR
  ADMIN
}

enum WorkspaceStatus {
  DRAFT
  PREVIEW_PROCESSING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PAYMENT_PENDING
  PAID
  FILES_UNLOCKED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  COMMENT
  CHANGES_REQUESTED
  PROJECT_APPROVED
  PAYMENT_COMPLETED
  FILES_DOWNLOADED
  PROCESSING_FAILED
  SYSTEM
}

/// Creator (and future admin) accounts. `email` is normalized
/// (trimmed + lowercased) by the application layer before every write and
/// read, so the DB-level `@unique` constraint enforces case-insensitive
/// uniqueness in practice without needing a citext extension.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  /// bcrypt hash. Never selected in any query except password verification
  /// during login — see src/data-access/auth.ts.
  passwordHash  String
  role          UserRole  @default(CREATOR)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clients       Client[]
  workspaces    Workspace[]
  notifications Notification[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name      String
  email     String
  company   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([creatorId])
  @@index([creatorId, name])
  @@map("clients")
}

model Workspace {
  id          String          @id @default(cuid())
  creatorId   String
  creator     User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  clientId    String
  /// Restrict (not Cascade): a client with financial history attached to a
  /// workspace should not be silently deletable once client-delete ships.
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title       String
  description String?
  /// ISO-style uppercase currency code (e.g. "INR"). Never a symbol.
  currency    String          @default("INR")
  /// Decimal, never Float — money is never represented in binary floating point.
  amount      Decimal         @db.Decimal(12, 2)
  status      WorkspaceStatus @default(DRAFT)
  /// 0-100. Redundant with `status` today (derivable from it) but stored
  /// explicitly so a future phase can support finer-grained progress
  /// within a single status without a schema change.
  progress    Int             @default(0)
  dueDate     DateTime?
  /// Secure client-review token. Nullable until a link has been shared;
  /// unique so a token can never resolve to more than one workspace.
  publicToken String?         @unique
  sharedAt    DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payments      Payment[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([creatorId])
  @@index([clientId])
  @@index([status])
  @@index([creatorId, status])
  @@index([creatorId, updatedAt])
  @@map("workspaces")
}

model Payment {
  id               String        @id @default(cuid())
  workspaceId      String
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  gateway          String        @default("razorpay")
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  feeAmount        Decimal?      @db.Decimal(12, 2)
  paidAt           DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@map("payments")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  /// SetNull (not Cascade): a notification about a deleted workspace should
  /// remain in the feed as history, not disappear silently.
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action      String
  actorType   String
  actorName   String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("activity_logs")
}
